# عُطْل. does not load this file automatically.
# These names are read from the process environment. Example in PowerShell:
#   $env:PORT = "3002"
#   npm start

# Basic app. Default host is loopback only.
PORT=3002
HOST=127.0.0.1

# Local Ollama. GitHub does not start Ollama or download the model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional. Leave unset to use ./data next to the application.
# DATA_DIR=
