# Loaded by start-local.mjs and demo-server.mjs. Do not commit .env.

PORT=3002
HOST=127.0.0.1

# Primary model provider. Groq no longer serves Llama 4 Maverick.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Used only when Groq fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick
